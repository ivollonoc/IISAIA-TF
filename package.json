{
  "name": "gestion-socios",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@prisma/client": "^6.10.0",
    "next": "^15.3.0",
    "next-auth": "^4.24.11",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-is": "^19.3.0",
    "recharts": "^3.10.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "prisma": "^6.10.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  },
  "allowScripts": {
    "esbuild": true,
    "prisma": true,
    "@prisma/client": true,
    "@prisma/engines": true,
    "sharp": true
  }
}
