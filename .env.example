# Postgres (docker-compose / Codespaces). En Vercel: DATABASE_URL con pooler y DIRECT_URL directa (Neon).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gestion_socios"
# Conexión directa que usa `prisma migrate` (sin pooler). En local es la misma que DATABASE_URL.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/gestion_socios"

# NextAuth: generar con `openssl rand -base64 32`
NEXTAUTH_SECRET="cambiar-por-un-secreto-largo"
# Toma el host del request (necesario en Codespaces/Vercel). En prod fijo, usar NEXTAUTH_URL.
AUTH_TRUST_HOST="true"
# NEXTAUTH_URL="http://localhost:3000"

# Email que obtiene rol SUPERADMIN al iniciar sesión
SUPERADMIN_EMAIL="admin@gestiondesocios.com"

# Login con Google (opcional): https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Login de demo por email sin contraseña. SOLO para desarrollo/presentación.
DEMO_LOGIN="true"

# Pasarela de pago online: "simulada" (tarjetas de prueba) o "mercadopago" (preparada, sin implementar)
PASARELA="simulada"

# Mails reales con Resend (opcional). Sin estas dos, los mails quedan simulados en el buzón de salida.
# EMAIL_FROM tiene que ser de un dominio verificado en Resend.
RESEND_API_KEY=""
EMAIL_FROM=""
