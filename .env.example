# Postgres (docker-compose / Codespaces). En Vercel: DATABASE_URL con pooler y DIRECT_URL directa (Neon).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gestion_socios"
# Conexión directa que usa `prisma migrate` (sin pooler). En local es la misma que DATABASE_URL.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/gestion_socios"

# NextAuth: generar con `openssl rand -base64 32`
NEXTAUTH_SECRET="cambiar-por-un-secreto-largo"
# Toma el host del request (necesario en Codespaces/Vercel). En prod fijo, usar NEXTAUTH_URL.
AUTH_TRUST_HOST="true"
# NEXTAUTH_URL="http://localhost:3000"

# Email del admin general que crea el seed
SUPERADMIN_EMAIL="admin@gestiondesocios.com"

# Login de los usuarios demo (marcados en la base) sin contraseña. SOLO para desarrollo/presentación.
# El resto entra con un link mágico por mail (y, con mails simulados y DEMO_LOGIN, el link se muestra en pantalla).
DEMO_LOGIN="true"

# URL pública de la app para los links de los mails (invitaciones y link mágico).
APP_URL="http://localhost:3000"

# Pasarela de pago online: "simulada" (tarjetas de prueba) o "mercadopago" (preparada, sin implementar)
PASARELA="simulada"

# Mails reales con Resend (opcional). Sin estas dos, los mails quedan simulados (solo se registran en la base).
# EMAIL_FROM tiene que ser de un dominio verificado en Resend.
RESEND_API_KEY=""
EMAIL_FROM=""

# Subdominio por club (opcional): con TENANT_MODE="subdomain", demo.<ROOT_DOMAIN> es la página del club
# y sus áreas son demo.<ROOT_DOMAIN>/admin y /socio. Por defecto ("path") todo va por /c/<slug>.
# Se leen al compilar (en Vercel, solo en Production). En local: ROOT_DOMAIN="localhost:3000".
# TENANT_MODE="subdomain"
# ROOT_DOMAIN="clubdesocios.com.ar"
