// Esquema multi-tenant: toda entidad de negocio lleva clubId y
// todas las consultas de la app filtran por él (ver src/modules/*/service.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Migraciones por conexión directa (en Neon, la URL sin "-pooler"); en local es la misma URL.
  directUrl = env("DIRECT_URL")
}

enum Rol {
  SUPERADMIN
  ADMIN_CLUB
  SOCIO
}

enum MedioPago {
  EFECTIVO
  TRANSFERENCIA
  ONLINE
  OTRO
}

enum ConceptoCargo {
  CUOTA
  ACTIVIDAD
  EVENTO
}

enum EstadoCargo {
  PENDIENTE
  PAGADO
  ANULADO
}

enum EstadoIntento {
  APROBADO
  RECHAZADO
  PENDIENTE
}

model Club {
  id                  String              @id @default(cuid())
  nombre              String
  slug                String              @unique
  diaVencimiento      Int                 @default(10) // 1..28
  createdAt           DateTime            @default(now())
  usuarios            Usuario[]
  tiposSocio          TipoSocio[]
  socios              Socio[]
  pagos               Pago[]
  actividades         Actividad[]
  inscripciones       Inscripcion[]
  cargos              Cargo[]
  intentosPago        IntentoPago[]
  excepcionesClase    ExcepcionClase[]
  eventos             Evento[]
  inscripcionesEvento InscripcionEvento[]
  listaEspera         ListaEspera[]
}

// Cuenta de login. En v1 un email pertenece a un único club.
model Usuario {
  id        String   @id @default(cuid())
  email     String   @unique
  nombre    String?
  rol       Rol
  clubId    String?
  club      Club?    @relation(fields: [clubId], references: [id], onDelete: Cascade)
  socio     Socio?
  createdAt DateTime @default(now())

  @@index([clubId])
}

model TipoSocio {
  id           String  @id @default(cuid())
  clubId       String
  club         Club    @relation(fields: [clubId], references: [id], onDelete: Cascade)
  nombre       String
  cuotaMensual Int // pesos enteros
  socios       Socio[]

  @@unique([clubId, nombre])
}

model Socio {
  id                  String              @id @default(cuid())
  clubId              String
  club                Club                @relation(fields: [clubId], references: [id], onDelete: Cascade)
  usuarioId           String?             @unique
  usuario             Usuario?            @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  nroSocio            Int
  nombre              String
  apellido            String
  dni                 String
  email               String?
  tipoSocioId         String
  tipoSocio           TipoSocio           @relation(fields: [tipoSocioId], references: [id])
  activo              Boolean             @default(true)
  createdAt           DateTime            @default(now())
  pagos               Pago[]
  inscripciones       Inscripcion[]
  cargos              Cargo[]
  intentosPago        IntentoPago[]
  inscripcionesEvento InscripcionEvento[]
  listaEspera         ListaEspera[]

  @@unique([clubId, nroSocio])
  @@unique([clubId, dni])
  @@index([clubId])
}

// Un pago cancela uno o más cargos completos; monto = suma de sus cargos.
model Pago {
  id            String       @id @default(cuid())
  clubId        String
  club          Club         @relation(fields: [clubId], references: [id], onDelete: Cascade)
  socioId       String
  socio         Socio        @relation(fields: [socioId], references: [id], onDelete: Cascade)
  monto         Int
  medio         MedioPago
  fecha         DateTime     @default(now())
  registradoPor String? // usuarioId del admin; null si es ONLINE
  cargos        Cargo[]
  intento       IntentoPago?

  @@index([clubId, fecha])
}

// Actividad recurrente: clases semanales según sus horarios, entre fechaInicio y fechaFin.
model Actividad {
  id            String             @id @default(cuid())
  clubId        String
  club          Club               @relation(fields: [clubId], references: [id], onDelete: Cascade)
  nombre        String
  descripcion   String?
  cupo          Int
  arancel       Int                @default(0) // pesos por mes; 0 = gratuita
  fechaInicio   DateTime // medianoche UTC; las clases empiezan ese día
  fechaFin      DateTime? // medianoche UTC, inclusive; null = sin fin
  createdAt     DateTime           @default(now())
  activa        Boolean            @default(true)
  horarios      HorarioActividad[]
  inscripciones Inscripcion[]
  cargos        Cargo[]
  excepciones   ExcepcionClase[]
  eventos       Evento[]
  listaEspera   ListaEspera[]

  @@index([clubId])
}

// Un horario por día de la semana: (actividadId, fecha) sigue identificando una clase.
model HorarioActividad {
  id          String    @id @default(cuid())
  actividadId String
  actividad   Actividad @relation(fields: [actividadId], references: [id], onDelete: Cascade)
  diaSemana   Int // 0 = domingo ... 6 = sábado
  hora        String // "HH:MM"
  duracionMin Int       @default(60)

  @@unique([actividadId, diaSemana])
}

model Inscripcion {
  id          String    @id @default(cuid())
  clubId      String
  club        Club      @relation(fields: [clubId], references: [id], onDelete: Cascade)
  actividadId String
  actividad   Actividad @relation(fields: [actividadId], references: [id], onDelete: Cascade)
  socioId     String
  socio       Socio     @relation(fields: [socioId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([actividadId, socioId])
  @@index([clubId])
}

// Deuda del socio: cuota social del período o arancel de una actividad.
model Cargo {
  id              String        @id @default(cuid())
  clubId          String
  club            Club          @relation(fields: [clubId], references: [id], onDelete: Cascade)
  socioId         String
  socio           Socio         @relation(fields: [socioId], references: [id], onDelete: Cascade)
  concepto        ConceptoCargo
  actividadId     String?
  actividad       Actividad?    @relation(fields: [actividadId], references: [id], onDelete: SetNull)
  clave           String // "CUOTA" | "ACT:<actividadId>" (NULL en actividadId no sirve para UNIQUE)
  descripcion     String // se conserva aunque se borre la actividad
  periodo         String // "YYYY-MM"
  monto           Int
  vencimiento     DateTime // medianoche UTC del día de vencimiento
  estado          EstadoCargo   @default(PENDIENTE)
  pagoId          String?
  pago            Pago?         @relation(fields: [pagoId], references: [id], onDelete: SetNull)
  motivoAnulacion String?
  createdAt       DateTime      @default(now())

  @@unique([socioId, periodo, clave])
  @@index([clubId, periodo])
  @@index([clubId, estado, vencimiento])
}

// Cada intento de pago online, aprobado o no. Nunca guarda el número completo ni el CVV.
model IntentoPago {
  id                String        @id @default(cuid())
  clubId            String
  club              Club          @relation(fields: [clubId], references: [id], onDelete: Cascade)
  socioId           String
  socio             Socio         @relation(fields: [socioId], references: [id], onDelete: Cascade)
  cargoIds          String[]
  monto             Int
  estado            EstadoIntento
  pasarela          String // "simulada" | "mercadopago"
  referenciaExterna String?
  motivoRechazo     String?
  ultimos4          String?
  pagoId            String?       @unique
  pago              Pago?         @relation(fields: [pagoId], references: [id], onDelete: SetNull)
  createdAt         DateTime      @default(now())

  @@index([clubId, estado])
}

enum TipoExcepcion {
  SUSPENDIDA
  REPROGRAMADA
}

// Lo único que se guarda de las clases: lo que se aparta de la regla semanal.
model ExcepcionClase {
  id          String        @id @default(cuid())
  clubId      String
  club        Club          @relation(fields: [clubId], references: [id], onDelete: Cascade)
  actividadId String
  actividad   Actividad     @relation(fields: [actividadId], references: [id], onDelete: Cascade)
  fecha       DateTime // día original de la clase (medianoche UTC)
  tipo        TipoExcepcion
  nuevaFecha  DateTime? // solo REPROGRAMADA (medianoche UTC)
  nuevaHora   String? // "HH:MM", solo REPROGRAMADA
  motivo      String
  createdAt   DateTime      @default(now())

  @@unique([actividadId, fecha])
  @@index([clubId, fecha])
  @@index([clubId, nuevaFecha])
}

// Evento puntual: para todo el club (actividadId null) o para los inscriptos de una actividad.
// Opcionalmente admite inscripción, con cupo (null = sin límite) y precio (genera un cargo único).
model Evento {
  id             String              @id @default(cuid())
  clubId         String
  club           Club                @relation(fields: [clubId], references: [id], onDelete: Cascade)
  titulo         String
  descripcion    String?
  fecha          DateTime // medianoche UTC
  hora           String // "HH:MM"
  duracionMin    Int                 @default(60)
  lugar          String?
  actividadId    String?
  actividad      Actividad?          @relation(fields: [actividadId], references: [id], onDelete: Cascade)
  conInscripcion Boolean             @default(false)
  cupo           Int?
  precio         Int                 @default(0)
  createdAt      DateTime            @default(now())
  inscripciones  InscripcionEvento[]
  listaEspera    ListaEspera[]

  @@index([clubId, fecha])
}

model InscripcionEvento {
  id        String   @id @default(cuid())
  clubId    String
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  eventoId  String
  evento    Evento   @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  socioId   String
  socio     Socio    @relation(fields: [socioId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([eventoId, socioId])
  @@index([clubId])
}

// Lista de espera de una actividad o de un evento llenos (exactamente uno de los dos).
model ListaEspera {
  id          String     @id @default(cuid())
  clubId      String
  club        Club       @relation(fields: [clubId], references: [id], onDelete: Cascade)
  socioId     String
  socio       Socio      @relation(fields: [socioId], references: [id], onDelete: Cascade)
  actividadId String?
  actividad   Actividad? @relation(fields: [actividadId], references: [id], onDelete: Cascade)
  eventoId    String?
  evento      Evento?    @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())

  @@unique([socioId, actividadId])
  @@unique([socioId, eventoId])
  @@index([clubId])
}
