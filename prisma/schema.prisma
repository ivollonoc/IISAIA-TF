// Esquema multi-tenant: toda entidad de negocio lleva clubId y
// todas las consultas de la app filtran por él (ver src/modules/*/service.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Migraciones por conexión directa (en Neon, la URL sin "-pooler"); en local es la misma URL.
  directUrl = env("DIRECT_URL")
}

enum Rol {
  SUPERADMIN
  ADMIN_CLUB
  SOCIO
}

enum MedioPago {
  EFECTIVO
  TRANSFERENCIA
  ONLINE
  OTRO
}

enum ConceptoCargo {
  CUOTA
  CLASE
  EVENTO
}

enum EstadoCargo {
  PENDIENTE
  PAGADO
  ANULADO
}

enum CanalAviso {
  IN_APP
  EMAIL
  SMS
}

enum EstadoIntento {
  APROBADO
  RECHAZADO
  PENDIENTE
}

model Club {
  id                  String              @id @default(cuid())
  nombre              String
  slug                String              @unique
  diaVencimiento      Int                 @default(10) // 1..28
  canales             CanalAviso[]        @default([IN_APP]) // vías de aviso a los socios (in-app siempre)
  createdAt           DateTime            @default(now())
  usuarios            Usuario[]
  tiposSocio          TipoSocio[]
  socios              Socio[]
  pagos               Pago[]
  actividades         Actividad[]
  reservas            Reserva[]
  cargos              Cargo[]
  intentosPago        IntentoPago[]
  excepcionesClase    ExcepcionClase[]
  eventos             Evento[]
  inscripcionesEvento InscripcionEvento[]
  listaEspera         ListaEspera[]
  notificaciones      Notificacion[]
  mensajesSalientes   MensajeSaliente[]
  avisosEnviados      AvisoEnviado[]
}

// Cuenta de login. En v1 un email pertenece a un único club.
model Usuario {
  id        String   @id @default(cuid())
  email     String   @unique
  nombre    String?
  rol       Rol
  clubId    String?
  club      Club?    @relation(fields: [clubId], references: [id], onDelete: Cascade)
  socio     Socio?
  createdAt DateTime @default(now())

  notificaciones Notificacion[]
  avisosEnviados AvisoEnviado[]

  @@index([clubId])
}

// Bandeja in-app de cada usuario.
model Notificacion {
  id        String    @id @default(cuid())
  usuarioId String
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  clubId    String?
  club      Club?     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  tipo      String // "PAGO_ACREDITADO", "CLASE_SUSPENDIDA", ...
  titulo    String
  cuerpo    String
  link      String? // ruta interna ("/c/demo/socio")
  leidaAt   DateTime?
  createdAt DateTime  @default(now())

  @@index([usuarioId, leidaAt])
}

// Mails y SMS enviados (simulados o reales): el "buzón de salida" visible en la app.
model MensajeSaliente {
  id        String     @id @default(cuid())
  clubId    String?
  club      Club?      @relation(fields: [clubId], references: [id], onDelete: Cascade)
  canal     CanalAviso // EMAIL | SMS
  destino   String // email o teléfono
  asunto    String?
  cuerpo    String
  proveedor String // "simulado" | "resend"
  createdAt DateTime   @default(now())

  @@index([clubId, createdAt])
}

model TipoSocio {
  id           String  @id @default(cuid())
  clubId       String
  club         Club    @relation(fields: [clubId], references: [id], onDelete: Cascade)
  nombre       String
  cuotaMensual Int // pesos enteros
  socios       Socio[]

  @@unique([clubId, nombre])
}

model Socio {
  id                  String              @id @default(cuid())
  clubId              String
  club                Club                @relation(fields: [clubId], references: [id], onDelete: Cascade)
  usuarioId           String?             @unique
  usuario             Usuario?            @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  nroSocio            Int
  nombre              String
  apellido            String
  dni                 String
  email               String?
  telefono            String? // para avisos por SMS
  titularId           String? // grupo familiar: socio titular (mismo club); null = sin grupo o es titular
  titular             Socio?              @relation("GrupoFamiliar", fields: [titularId], references: [id], onDelete: SetNull)
  familiares          Socio[]             @relation("GrupoFamiliar")
  pagosHechos         Pago[]              @relation("PagosDelTitular")
  tipoSocioId         String
  tipoSocio           TipoSocio           @relation(fields: [tipoSocioId], references: [id])
  activo              Boolean             @default(true)
  createdAt           DateTime            @default(now())
  pagos               Pago[]              @relation("PagosDelSocio")
  reservas            Reserva[]
  cargos              Cargo[]
  intentosPago        IntentoPago[]
  inscripcionesEvento InscripcionEvento[]
  listaEspera         ListaEspera[]

  @@unique([clubId, nroSocio])
  @@unique([clubId, dni])
  @@index([clubId])
  @@index([titularId])
}

// Un pago cancela uno o más cargos completos; monto = suma de sus cargos.
model Pago {
  id            String       @id @default(cuid())
  clubId        String
  club          Club         @relation(fields: [clubId], references: [id], onDelete: Cascade)
  socioId       String
  socio         Socio        @relation("PagosDelSocio", fields: [socioId], references: [id], onDelete: Cascade)
  monto         Int
  medio         MedioPago
  fecha         DateTime     @default(now())
  registradoPor String? // usuarioId del admin; null si es ONLINE
  pagadorId     String? // titular que pagó por un familiar; null = lo pagó el propio socio
  pagador       Socio?       @relation("PagosDelTitular", fields: [pagadorId], references: [id], onDelete: SetNull)
  intentoId     String? // intento online que lo generó (uno puede generar varios pagos: grupo familiar)
  intento       IntentoPago? @relation(fields: [intentoId], references: [id], onDelete: SetNull)
  cargos        Cargo[]

  @@index([clubId, fecha])
}

// Actividad recurrente: clases semanales según sus horarios, entre fechaInicio y fechaFin.
model Actividad {
  id          String             @id @default(cuid())
  clubId      String
  club        Club               @relation(fields: [clubId], references: [id], onDelete: Cascade)
  nombre      String
  descripcion String?
  cupo        Int
  precioClase Int                @default(0) // pesos por clase reservada; 0 = gratis
  fechaInicio DateTime // medianoche UTC; las clases empiezan ese día
  fechaFin    DateTime? // medianoche UTC, inclusive; null = sin fin
  createdAt   DateTime           @default(now())
  activa      Boolean            @default(true)
  horarios    HorarioActividad[]
  reservas    Reserva[]
  cargos      Cargo[]
  excepciones ExcepcionClase[]
  eventos     Evento[]
  listaEspera ListaEspera[]

  @@index([clubId])
}

// Horarios semanales: un día puede tener varios (lunes 9:00 y lunes 17:00). Una clase se
// identifica por (actividadId, fecha, hora).
model HorarioActividad {
  id          String    @id @default(cuid())
  actividadId String
  actividad   Actividad @relation(fields: [actividadId], references: [id], onDelete: Cascade)
  diaSemana   Int // 0 = domingo ... 6 = sábado
  hora        String // "HH:MM"
  duracionMin Int       @default(60)

  @@unique([actividadId, diaSemana, hora])
}

// Reserva de un socio a una clase concreta (actividad, fecha, hora original de la clase).
model Reserva {
  id          String    @id @default(cuid())
  clubId      String
  club        Club      @relation(fields: [clubId], references: [id], onDelete: Cascade)
  actividadId String
  actividad   Actividad @relation(fields: [actividadId], references: [id], onDelete: Cascade)
  socioId     String
  socio       Socio     @relation(fields: [socioId], references: [id], onDelete: Cascade)
  fecha       DateTime // día de la clase (medianoche UTC)
  hora        String // hora original de la clase "HH:MM"
  createdAt   DateTime  @default(now())

  @@unique([actividadId, fecha, hora, socioId])
  @@index([clubId, fecha])
  @@index([socioId, fecha])
}

// Deuda del socio: cuota social del período, una clase reservada o un evento.
model Cargo {
  id              String        @id @default(cuid())
  clubId          String
  club            Club          @relation(fields: [clubId], references: [id], onDelete: Cascade)
  socioId         String
  socio           Socio         @relation(fields: [socioId], references: [id], onDelete: Cascade)
  concepto        ConceptoCargo
  actividadId     String?
  actividad       Actividad?    @relation(fields: [actividadId], references: [id], onDelete: SetNull)
  clave           String // "CUOTA" | "CLA:<actividadId>:<fecha>:<hora>" | "EVT:<eventoId>"
  descripcion     String // se conserva aunque se borre la actividad
  periodo         String // "YYYY-MM"
  monto           Int
  vencimiento     DateTime // medianoche UTC del día de vencimiento
  estado          EstadoCargo   @default(PENDIENTE)
  pagoId          String?
  pago            Pago?         @relation(fields: [pagoId], references: [id], onDelete: SetNull)
  motivoAnulacion String?
  createdAt       DateTime      @default(now())

  @@unique([socioId, periodo, clave])
  @@index([clubId, periodo])
  @@index([clubId, estado, vencimiento])
}

// Cada intento de pago online, aprobado o no. Nunca guarda el número completo ni el CVV.
model IntentoPago {
  id                String        @id @default(cuid())
  clubId            String
  club              Club          @relation(fields: [clubId], references: [id], onDelete: Cascade)
  socioId           String
  socio             Socio         @relation(fields: [socioId], references: [id], onDelete: Cascade)
  cargoIds          String[]
  monto             Int
  estado            EstadoIntento
  pasarela          String // "simulada" | "mercadopago"
  referenciaExterna String?
  motivoRechazo     String?
  ultimos4          String?
  pagos             Pago[]
  createdAt         DateTime      @default(now())

  @@index([clubId, estado])
}

enum TipoExcepcion {
  SUSPENDIDA
  REPROGRAMADA
}

// Lo único que se guarda de las clases: lo que se aparta de la regla semanal.
model ExcepcionClase {
  id          String        @id @default(cuid())
  clubId      String
  club        Club          @relation(fields: [clubId], references: [id], onDelete: Cascade)
  actividadId String
  actividad   Actividad     @relation(fields: [actividadId], references: [id], onDelete: Cascade)
  fecha       DateTime // día original de la clase (medianoche UTC)
  hora        String // hora original de la clase "HH:MM" (un día puede tener varias)
  tipo        TipoExcepcion
  nuevaFecha  DateTime? // solo REPROGRAMADA (medianoche UTC)
  nuevaHora   String? // "HH:MM", solo REPROGRAMADA
  motivo      String
  createdAt   DateTime      @default(now())

  @@unique([actividadId, fecha, hora])
  @@index([clubId, fecha])
  @@index([clubId, nuevaFecha])
}

// Evento puntual: para todo el club (actividadId null) o para los inscriptos de una actividad.
// Opcionalmente admite inscripción, con cupo (null = sin límite) y precio (genera un cargo único).
model Evento {
  id             String              @id @default(cuid())
  clubId         String
  club           Club                @relation(fields: [clubId], references: [id], onDelete: Cascade)
  titulo         String
  descripcion    String?
  fecha          DateTime // medianoche UTC
  hora           String // "HH:MM"
  duracionMin    Int                 @default(60)
  lugar          String?
  actividadId    String?
  actividad      Actividad?          @relation(fields: [actividadId], references: [id], onDelete: Cascade)
  conInscripcion Boolean             @default(false)
  cupo           Int?
  precio         Int                 @default(0)
  createdAt      DateTime            @default(now())
  inscripciones  InscripcionEvento[]
  listaEspera    ListaEspera[]

  @@index([clubId, fecha])
}

model InscripcionEvento {
  id        String   @id @default(cuid())
  clubId    String
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  eventoId  String
  evento    Evento   @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  socioId   String
  socio     Socio    @relation(fields: [socioId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([eventoId, socioId])
  @@index([clubId])
}

// Lista de espera de una clase llena (actividad + fecha + hora) o de un evento lleno.
model ListaEspera {
  id          String     @id @default(cuid())
  clubId      String
  club        Club       @relation(fields: [clubId], references: [id], onDelete: Cascade)
  socioId     String
  socio       Socio      @relation(fields: [socioId], references: [id], onDelete: Cascade)
  actividadId String?
  actividad   Actividad? @relation(fields: [actividadId], references: [id], onDelete: Cascade)
  fecha       DateTime? // clase en espera (solo actividades)
  hora        String?
  eventoId    String?
  evento      Evento?    @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())

  @@unique([socioId, actividadId, fecha, hora])
  @@unique([socioId, eventoId])
  @@index([clubId])
}

// Historial de avisos manuales: lo que envió un club a sus socios o la plataforma a los clubes.
// No guarda los avisos individuales (esos son privados de cada usuario).
model AvisoEnviado {
  id            String       @id @default(cuid())
  origen        String // "CLUB" | "PLATAFORMA"
  clubId        String? // club que lo envía (null si es de la plataforma)
  club          Club?        @relation(fields: [clubId], references: [id], onDelete: Cascade)
  autorId       String?
  autor         Usuario?     @relation(fields: [autorId], references: [id], onDelete: SetNull)
  asunto        String
  mensaje       String
  para          String // "Todos los socios", "Inscriptos de Yoga", "Todos los clubes", "Club Atlas"
  destinatarios Int
  canales       CanalAviso[]
  createdAt     DateTime     @default(now())

  @@index([origen, clubId, createdAt])
}
